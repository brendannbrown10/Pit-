---
import "../styles/global.css";
const { title = "The Pit Archive", showNav = true } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="A personal archive of metal memorabilia and live shots." />
  </head>
  <body>
    <div class="wrap">
      {showNav && (
        <nav class="nav">
          <a href="/">← The Wall</a>
          <a href="/admin">Curator login</a>
        </nav>
      )}
      <slot />
    </div>
  </body>
</html>
